{
  "name": "transcript-service",
  "version": "2.0.0",
  "description": "Servicio de transcripcion de audio con IA: pipeline paralelo con ffmpeg, cola de trabajos y plantillas de post-proceso",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/queue/worker.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "create-user": "node src/scripts/create-user.js",
    "check-models": "node src/scripts/check-models.js",
    "transcribe": "node src/scripts/transcribe-cli.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "better-sqlite3": "^12.4.1",
    "bullmq": "^5.63.0",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2"
  },
  "license": "MIT"
}
