# ==========================================================================
#  Configuracion del servicio de transcripcion
#  Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# ==========================================================================

# --- Claves de proveedores (al menos una) ---------------------------------
# Groq  -> https://console.groq.com/keys   (el motor mas rapido y barato)
GROQ_API_KEY=
# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Servidor -------------------------------------------------------------
PORT=3001
NODE_ENV=production
# Secreto de sesion. Genera uno con: openssl rand -hex 32
SESSION_SECRET=
# Codigo de invitacion para que la gente se cree la cuenta desde la pantalla
# de acceso. Con un valor (min. 8 caracteres) aparece el enlace "Crear una" y
# entra quien tenga el codigo; vacio, el registro queda cerrado y las altas se
# hacen solo con `npm run create-user`. Cambiarlo invalida el anterior, pero
# no afecta a las cuentas ya creadas.
# Genera uno con: openssl rand -base64 12
SIGNUP_CODE=
# Dominio publico. Solo lo usa Caddy en docker-compose.yml para pedir el
# certificado TLS. Con Dokploy no hace falta: el dominio se configura en su
# interfaz y de el se encarga Traefik.
PUBLIC_HOST=localhost

# --- Cola -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Pipeline de audio ----------------------------------------------------
# Duracion objetivo de cada trozo, en segundos (600 = 10 min)
CHUNK_TARGET_SECONDS=600
# Cuantos trozos se transcriben a la vez
TRANSCRIBE_CONCURRENCY=4
# Cuantos trabajos procesa el worker simultaneamente
WORKER_CONCURRENCY=2
# Tamano maximo de subida en MB (el audio se comprime despues, asi que
# esto solo limita la subida del navegador)
MAX_UPLOAD_MB=500
