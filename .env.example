# ==========================================================================
#  Configuracion del servicio de transcripcion
#  Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# ==========================================================================

# --- Claves de proveedores (al menos una) ---------------------------------
# Groq  -> https://console.groq.com/keys   (el motor mas rapido y barato)
GROQ_API_KEY=
# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Servidor -------------------------------------------------------------
PORT=3001
NODE_ENV=production
# Secreto de sesion. Genera uno con: openssl rand -hex 32
SESSION_SECRET=
# Dominio publico (para la cookie segura y CORS). Ej: transcript.midominio.com
PUBLIC_HOST=localhost

# --- Cola -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Pipeline de audio ----------------------------------------------------
# Duracion objetivo de cada trozo, en segundos (600 = 10 min)
CHUNK_TARGET_SECONDS=600
# Cuantos trozos se transcriben a la vez
TRANSCRIBE_CONCURRENCY=4
# Cuantos trabajos procesa el worker simultaneamente
WORKER_CONCURRENCY=2
# Tamano maximo de subida en MB (el audio se comprime despues, asi que
# esto solo limita la subida del navegador)
MAX_UPLOAD_MB=500
